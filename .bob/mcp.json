{
  "mcpServers": {
    "watsonx-orchestrate-adk-docs": {
      "type": "streamable-http", 
      "command": "uvx",
      "args": [
        "mcp-proxy",
        "--transport",
        "streamablehttp",
        "https://developer.watson-orchestrate.ibm.com/mcp"
      ],
      "timeout": 120000
    },
    "watsonx-orchestrate-adk": {  
      "command": "uvx",
      "args": [
        "ibm-watsonx-orchestrate-mcp-server"
      ],
      "env": {
        "WXO_MCP_WORKING_DIRECTORY": "c:\\Users\\ayhng\\OneDrive\\Desktop\\IBM-V3",
        "WXO_MCP_DEBUG": ""
      },
      "timeout": 120000
    }
  }
}